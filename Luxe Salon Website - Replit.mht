.gold-button:hover { background: rgb(213, 182, 141); transform: translateY(-2px); }

.outline-button { border: 1px solid rgba(250, 245, 239, 0.62); color: var(--ivory); transition: background 0.2s; }

.outline-button:hover { background: rgba(250, 245, 239, 0.12); }

.gallery-card { cursor: zoom-in; }

.gallery-card img { transition: transform 0.5s; }

.gallery-card:hover img { transform: scale(1.045); }

.field { background: rgb(255, 253, 250); border: 1px solid rgb(221, 209, 195); transition: border-color 0.2s, box-shadow 0.2s; }

.field:focus { outline: none; border-color: var(--champagne); box-shadow: rgba(199, 164, 119, 0.18) 0px 0px 0px 3px; }

.field[aria-invalid="true"] { border-color: rgb(164, 63, 53); }

