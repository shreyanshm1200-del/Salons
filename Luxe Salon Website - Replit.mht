@layer base {
  * { border-color: hsl(var(--border)); }
  body { background-color: hsl(var(--background)); font-family: var(--app-font-sans); color: hsl(var(--foreground)); -webkit-font-smoothing: antialiased; }
}

html { scroll-behavior: smooth; scroll-padding-top: 88px; }

body { background: var(--ivory); font-family: var(--app-font-sans); }

::selection { background: var(--rose); color: var(--espresso); }

.serif { font-family: var(--app-font-serif); }

.site-header { background: rgba(250, 245, 239, 0.94); backdrop-filter: blur(16px); }

.eyebrow { letter-spacing: 0.22em; text-transform: uppercase; font-size: 0.68rem; font-weight: 700; }

.section-pad { padding: clamp(5rem, 10vw, 9rem) max(1.35rem, -600px + 50vw); }

.hero-copy { animation: 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running rise-in; }

.reveal { animation: 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running rise-in; }

.scroll-reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.7s, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }

.scroll-reveal.is-visible { opacity: 1; transform: translateY(0px); }

.mobile-nav-enter { transform-origin: center top; animation: 0.22s ease-out 0s 1 normal both running menu-drop; }

@keyframes menu-drop { 
  0% { opacity: 0; transform: translateY(-8px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes rise-in { 
  0% { opacity: 0; transform: translateY(22px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.editorial-image { object-fit: cover; width: 100%; height: 100%; }

.image-wash { background: linear-gradient(transparent 45%, rgba(33, 23, 20, 0.68)); }

.nav-link { position: relative; }

.nav-link::after { content: ""; position: absolute; height: 1px; bottom: -5px; left: 0px; right: 100%; background: var(--champagne); transition: right 0.25s; }

.nav-link:hover::after, .nav-link:focus-visible::after { right: 0px; }

.gold-button { background: var(--champagne); color: var(--espresso); transition: transform 0.2s, background 0.2s; }

.gold-button:hover { background: rgb(213, 182, 141); transform: translateY(-2px); }

.outline-button { border: 1px solid rgba(250, 245, 239, 0.62); color: var(--ivory); transition: background 0.2s; }

.outline-button:hover { background: rgba(250, 245, 239, 0.12); }

.gallery-card { cursor: zoom-in; }

.gallery-card img { transition: transform 0.5s; }

.gallery-card:hover img { transform: scale(1.045); }

.field { background: rgb(255, 253, 250); border: 1px solid rgb(221, 209, 195); transition: border-color 0.2s, box-shadow 0.2s; }

.field:focus { outline: none; border-color: var(--champagne); box-shadow: rgba(199, 164, 119, 0.18) 0px 0px 0px 3px; }

.field[aria-invalid="true"] { border-color: rgb(164, 63, 53); }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, ::before, ::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}

